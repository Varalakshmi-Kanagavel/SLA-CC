# Local demo runs without Kubernetes or Prometheus credentials.
CLOUDSCALE_MODE=simulation
PROMETHEUS_URL=
KUBERNETES_NAMESPACE=

# Optional controller runtime (k8s/controller.yaml uses the same defaults).
PROMETHEUS_P95_QUERY=histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le)) * 1000
PROMETHEUS_TIMEOUT_SECONDS=3
SLO_MS=200
INITIAL_CPU_TARGET=70
MIN_CPU_TARGET=40
MAX_CPU_TARGET=85
CONTROL_INTERVAL_SECONDS=10
COOLDOWN_SECONDS=60
WARNING_MULTIPLIER=1.2
CRITICAL_MULTIPLIER=1.5
HEALTHY_MULTIPLIER=0.8
NORMAL_DECREASE=5
CRITICAL_DECREASE=7.5
INCREASE_STEP=1
MAX_METRIC_AGE_SECONDS=30
HPA_NAME=webapp-hpa
KUBERNETES_DRY_RUN=true
LEASE_NAME=cloudscale-controller-lock
LEASE_DURATION_SECONDS=30
